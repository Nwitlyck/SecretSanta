<%- include('partials/header') %>
<main class="choose-page" id="main-content">
  <span class="eyebrow">UN MISMO ENLACE, MUCHAS SORPRESAS</span>
  <h1>¿Quién <em>eres?</em></h1>
  <p class="muted">Elige tu nombre para descubrir a quién le regalas<br>y escribir lo que te gustaría recibir.</p>
  <section class="panel choose-panel" aria-labelledby="choose-heading">
    <div class="card-heading"><span class="step-dot">01</span><h2 id="choose-heading">Busca tu nombre</h2></div>
    <p class="muted">Selecciona tu nombre. Después ingresa tu PIN o crea uno si es tu primera vez.</p>
    <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/exchange/join" id="choose-participant-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="token" value="<%= token %>">
      <label class="field-label" for="participant-name">Tu nombre</label>
      <select id="participant-name" name="name" required>
        <option value="" disabled selected>Selecciona tu nombre</option>
        <% exchange.participants.forEach(person => { %>
        <option value="<%= person.name %>" <%= person.available ? '' : 'disabled' %>><%= person.name %><%= person.available ? '' : ' (pendiente)' %></option>
        <% }); %>
      </select>
      <button class="button button-primary full-width" type="submit">Continuar <span aria-hidden="true">↗</span></button>
    </form>
    <p class="card-footnote">Elige solo tu nombre para mantener la sorpresa.</p>
  </section>
</main>
<%- include('partials/footer') %>
